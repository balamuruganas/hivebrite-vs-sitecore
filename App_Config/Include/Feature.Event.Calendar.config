<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/">
  <sitecore role:require="Standalone or ContentManagement">

    <events>
      <event name="item:saved">
        <handler type="Feature.Event.Calendar.Events.CalendarEventItemHandler, Feature.Event.Calendar"
                 method="OnItemSaved" />
      </event>
    </events>

    <scheduling>
      <!-- Runs daily; rolls the occurrence window forward for open-ended recurring events. -->
      <agent type="Feature.Event.Calendar.Tasks.RollCalendarOccurrencesAgent, Feature.Event.Calendar"
             method="Run" interval="1.00:00:00">
        <param desc="database">master</param>
        <param desc="rootPath">/sitecore/content</param>
        <HorizonDays>365</HorizonDays>
      </agent>
    </scheduling>

  </sitecore>
</configuration>
